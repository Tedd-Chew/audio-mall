# 复制成 application.yml 再填真实值：cp application.yml.example application.yml
# 中间件的账号密码跟项目根目录的 .env 保持一致

server:
  port: 8080

spring:
  datasource:
    # 端口 3307：3306 是本机已装的 MySQL，容器映射到了 3307
    url: jdbc:mysql://localhost:3307/audio_mall?useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
    username: root
    password: <你的 MySQL 密码>
    driver-class-name: com.mysql.cj.jdbc.Driver
    hikari:
      maximum-pool-size: 20
      minimum-idle: 5
      idle-timeout: 30000
      # 借连接的超时。调小 = 依赖故障时失败得快、少占线程；
      # 代价是"能自动扛住的停机时长"同比缩短（见 docs/可靠性实验.md E2）。
      connection-timeout: 5000
      max-lifetime: 1800000

  # 定时任务默认只有 1 个线程，两个 @Scheduled 会互相阻塞：
  # OrderTimeoutTask 一轮扫完之后，SeckillActivityCloseTask 才开始跑。
  # 给 2 个线程，各自独立调度。两个任务本身都是条件 UPDATE，多实例/并发都安全。
  task:
    scheduling:
      pool:
        size: 2

  # Spring Boot 3 的路径是 spring.data.redis（2.x 是 spring.redis），写错不报错但连不上
  data:
    redis:
      host: localhost
      port: 6379
      password: <你的 Redis 密码>
      database: 0
      # 命令超时，不配默认 60 秒 —— Redis 停机时每个请求都会卡满超时才报错。
      timeout: 1s
      connect-timeout: 200ms
      lettuce:
        pool:
          max-active: 8
          max-idle: 8
          min-idle: 0

  rabbitmq:
    host: localhost
    port: 5672
    username: admin
    password: <你的 RabbitMQ 密码>
    publisher-confirm-type: correlated
    listener:
      simple:
        acknowledge-mode: manual
        concurrency: 2
        max-concurrency: 4
        prefetch: 10
        auto-startup: true

  servlet:
    multipart:
      enabled: true
      max-file-size: 10MB
      max-request-size: 50MB

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.example.audiobackend.entity
  configuration:
    # 数据库的 cover_img 自动映射到 Java 的 coverImg
    map-underscore-to-camel-case: true
    # 开发时在控制台打印实际执行的 SQL
    log-impl: org.apache.ibatis.logging.stdout.StdOutImpl

upload:
  base-path: ./uploads
  home-path: home
  product-path: product

jwt:
  secret: <随机字符串，建议 32 位以上>
  # Token 有效期（毫秒）。本地压测环境给 7 天，否则压测跑到一半 token 就过期；
  # 生产环境应改回 7200000（2 小时）或更短。
  # 这一个值同时决定 JWT 的 exp 和 Redis 里 user:token:{userId} 的 TTL。
  expire-time: 604800000

payment:
  # 支付回调的签名密钥 —— 相当于支付平台和我方共享的口令，绝不能出现在任何请求里。
  # 生产环境必须换成随机 32 位以上，并通过环境变量注入。
  callback-secret: <随机字符串，建议 32 位以上>
  # 回调时间戳的容忍窗口（秒）。超出这个范围的回调一律判为重放。
  callback-tolerance-seconds: 300

seckill:
  rate:
    # 令牌桶容量 = 允许的瞬时突发。参考 Tomcat 线程数（默认 200），先给 500
    capacity: 500
    # 每秒补充的令牌数 = 长期放行速率。按压测出来的单机上限调，先给 200
    permits-per-second: 200
