# 应用的 systemd EnvironmentFile 模板。
# 真实值复制成 app.env 后填写，app.env 不进版本库。
#
# 这些变量一一对应 application-prod.yml 里的 ${...} 占位：
# 漏一个，应用会启动失败（这是故意的，见 application-prod.yml 顶部注释）

SERVER_PORT=8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=audio_mall
DB_USER=root
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

MQ_HOST=127.0.0.1
MQ_PORT=5672
MQ_USER=admin
MQ_PASSWORD=

# 至少 32 字节（HS256 的密钥长度要求），用 openssl rand -base64 36 生成
JWT_SECRET=
JWT_EXPIRE_TIME=7200000

PAYMENT_CALLBACK_SECRET=

UPLOAD_BASE_PATH=/opt/audio-mall/uploads
