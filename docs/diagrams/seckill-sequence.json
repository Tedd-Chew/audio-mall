  "cards": [
    {
      "dot": "emerald",
      "title": "库存一致性",
      "items": [
        "Redis 扣的是「名额」，MySQL 才是账本，两边要对得上",
        "Lua 里检查与扣减一步完成，中间没有窗口，所以不会超卖",
        "DB 写失败（真实冲突）必须把 Redis 名额加回去，否则名额凭空消失"
      ]
    },
    {
      "dot": "violet",
      "title": "Lua 里的执行顺序",
      "items": [
        "幂等快路径 → 令牌桶限流 → 时间窗 → 库存 → 一人一单 → 写幂等并扣减",
        "幂等判断放在最前且只读：重复请求不消耗令牌、不碰库存",
        "限流在扣库存之前：先挡掉无效请求，避免库存被刷空"
      ]
    },
    {
      "dot": "rose",
      "title": "撞唯一索引的两种含义",
      "items": [
        "uk_order_no 冲突 = 同一条消息重复投递，订单早建好了，直接 ack",
        "uk_user_request 冲突 = 同一用户另一单真抢到了，本次必须回滚名额",
        "判据是「按 order_no 查不查得到」，不能一律当成重复"
      ]
    },
    {
      "dot": "cyan",
      "title": "分布式的三个前提",
      "items": [
        "应用无状态：库存、幂等、会话全在 Redis/MySQL/MQ",
        "所以 Nginx 轮询即可，不需要粘性会话",
        "手动 ack + prefetch 10：进程被杀时未确认消息会重投，靠唯一索引兜住"
      ]
    }
  ]
}
